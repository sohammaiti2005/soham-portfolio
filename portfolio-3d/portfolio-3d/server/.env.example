# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real .env file to GitHub — it contains a secret password.

EMAIL_USER=your.email@gmail.com

# A Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for your Google account.)
EMAIL_PASS=your16charapppassword

EMAIL_TO=your.email@gmail.com

PORT=3000
